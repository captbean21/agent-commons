[Unit]
Description=Frankenstein MoE - Heavy Reasoning Cortex (MoE in DDR4 RAM)
After=network.target

[Service]
Type=simple
User=rook
WorkingDirectory=/home/rook
ExecStart=/opt/llama.cpp/build/bin/llama-server \
  -m /models/DeepSeek-Coder-V2-Lite-Instruct-Q4_K_M.gguf \
  --spec-draft /models/qwen2.5-1.5b-instruct-q4_k_m.gguf \
  --spec-draft-ngl 99 \
  -c 32768 \
  -ctk q8_0 -ctv q8_0 \
  -t 6 \
  --fit on \
  --host 0.0.0.0 \
  --port 5001 \
  --parallel 1 \
  --cont-batching
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
